# NetCoop environment (copy to .env). Never commit real values.
# LLM is optional and OFF by default: off | local | cloud
NETCOOP_LLM=off
# local (Ollama)
NETCOOP_OLLAMA_URL=http://127.0.0.1:11434
NETCOOP_LOCAL_MODEL=
# cloud (Anthropic API)
ANTHROPIC_API_KEY=
NETCOOP_CLOUD_MODEL=claude-haiku-5-5
# 1 = replace entity IDs with tokens before cloud calls (PI7)
NETCOOP_REDACT=1
