{
  "$defs": {
    "EntityRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_.:\\-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "device",
            "link",
            "ap",
            "service"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "SignalRef": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "$ref": "#/$defs/EntityRef"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/Window"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "metric",
        "entity"
      ],
      "title": "SignalRef",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "$id": "https://netcoop.local/schemas/nmp-1.0/payload.evidence_request.schema.json",
  "additionalProperties": false,
  "properties": {
    "prediction_ids": {
      "items": {
        "type": "string"
      },
      "title": "Prediction Ids",
      "type": "array"
    },
    "reason": {
      "default": "prediction",
      "title": "Reason",
      "type": "string"
    },
    "requests": {
      "items": {
        "$ref": "#/$defs/SignalRef"
      },
      "title": "Requests",
      "type": "array"
    },
    "round": {
      "title": "Round",
      "type": "integer"
    }
  },
  "required": [
    "round",
    "requests"
  ],
  "title": "EvidenceRequestPayload",
  "type": "object"
}
