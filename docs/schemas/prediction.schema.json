{
  "$defs": {
    "EntityRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_.:\\-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "device",
            "link",
            "ap",
            "service"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "Expectation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            ">=",
            "<=",
            "<",
            ">"
          ],
          "title": "Op",
          "type": "string"
        },
        "ref": {
          "enum": [
            "warn",
            "high",
            "critical"
          ],
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "op",
        "ref"
      ],
      "title": "Expectation",
      "type": "object"
    },
    "SignalRef": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "$ref": "#/$defs/EntityRef"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/Window"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "metric",
        "entity"
      ],
      "title": "SignalRef",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "$id": "https://netcoop.local/schemas/nmp-1.1/prediction.schema.json",
  "additionalProperties": false,
  "properties": {
    "evidence_finding_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Finding Id"
    },
    "expected": {
      "$ref": "#/$defs/Expectation"
    },
    "fault_type": {
      "title": "Fault Type",
      "type": "string"
    },
    "hypothesis_id": {
      "title": "Hypothesis Id",
      "type": "string"
    },
    "outcome": {
      "default": "pending",
      "enum": [
        "pending",
        "hit",
        "miss",
        "unknown"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "prediction_id": {
      "title": "Prediction Id",
      "type": "string"
    },
    "round": {
      "default": 1,
      "title": "Round",
      "type": "integer"
    },
    "signal": {
      "$ref": "#/$defs/SignalRef"
    }
  },
  "required": [
    "prediction_id",
    "hypothesis_id",
    "fault_type",
    "signal",
    "expected"
  ],
  "title": "Prediction",
  "type": "object"
}
